# Copy to .env.local for local testing of a production-style build, or set these directly
# in the Vercel project's Environment Variables (Settings > Environment Variables).
# Leave unset for local `npm run dev` - the Vite proxy in vite.config.js handles /api locally.

# Full URL of the deployed backend's API, including the /api suffix.
VITE_API_BASE_URL=https://itech-broadcast-api.onrender.com/api
