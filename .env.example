# Copy to .env before running docker compose
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-db
# at least 32 characters
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-characters

# The address people open in the browser
APP_PUBLIC_URL=http://localhost:3000

# Only accept sign-up emails from this domain, e.g. your college's. Blank = any email address.
ALLOWED_EMAIL_DOMAIN=

# --- Club coordinator sign-in ---
# There's no separate admin page: the coordinator signs in on the SAME login form as students.
# Entering this exact username + password opens the admin portal instead of the student pages.
# Pick your own values below - the app updates the stored (hashed) credential automatically on restart
# if you change these. Do not commit your real .env file or share these values publicly.
ADMIN_USERNAME=change-me@yourclub
ADMIN_PASSWORD=choose-a-strong-password

# optional email (leave MAIL_ENABLED=false to just log emails)
MAIL_ENABLED=false
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@itechbroadcast.local
